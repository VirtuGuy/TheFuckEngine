import funkin.play.character.Character;

class DarnellBlazinCharacter extends Character
{
    var num:Int = 0;

    public function new()
    {
        super("darnell-blazin");
    }

    function punch()
    {
        var name:String = 'high';

        if (FlxG.random.bool(50))
            name = 'low';

        num = 1 - num;

        playAnimation('punch-$name-$num', true);
    }

    function block()
    {
        playAnimation('block', true);
    }

    function dodge()
    {
        playAnimation('dodge', true);
    }

    override function onNoteHit(event:NoteScriptEvent)
    {
        if (FlxG.random.bool(20))
            block();
        else if (FlxG.random.bool(5))
            dodge();
        else
            punch();
    }

    override function onNoteMiss(event:NoteScriptEvent)
    {
        punch();
    }
}