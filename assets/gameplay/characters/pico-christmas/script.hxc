import funkin.play.character.Character;

class PicoChristmasCharacter extends Character
{
    public function new()
    {
        super('pico-christmas');
    }

    override function getDeathCharacter():String
    {
        return 'pico-death';
    }

    override function getPauseMusic():String
    {
        return getPath('pause', 'pico');
    }
}