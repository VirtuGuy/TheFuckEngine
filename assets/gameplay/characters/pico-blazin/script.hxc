import funkin.play.character.Character;
import funkin.play.PauseSubState;

class PicoBlazinCharacter extends Character
{
    var num:Int = 0;

    public function new()
    {
        super('pico-blazin');
    }

    function punch()
    {
        var name:String = 'high';

        if (FlxG.random.bool(50))
            name = 'low';

        num = 1 - num;

        playAnimation('punch-$name-$num', true);

        // Shakes the camera for the cool
        camera.shake(0.002, 0.1);
    }

    function block()
    {
        playAnimation('block', true);
    }

    function dodge()
    {
        playAnimation('dodge', true);
    }

    override function onCreate(event:ScriptEvent)
    {
        super.onCreate(event);

        PauseSubState.musicId = 'pico';
    }

    override function onNoteHit(event:NoteScriptEvent)
    {
        if (FlxG.random.bool(30))
            block();
        else if (FlxG.random.bool(15))
            dodge();
        else
            punch();
    }

    override function onNoteMiss(event:NoteScriptEvent)
    {
        block();
    }
}