import funkin.play.character.Character;

class BFChristmasCharacter extends Character
{
    public function new()
    {
        super('bf-christmas');
    }

    override function getDeathCharacter():String
    {
        return 'bf-death';
    }

    override function getPauseMusic():String
    {
        return getPath('pause', 'bf');
    }
}